# Sensitive SQLAlchemy async connection URL for the PostgreSQL database used by the Server.
OPENOCTOPUS_DATABASE_URL=postgresql+asyncpg://openoctopus:octopus@localhost:5432/openoctopus
# Number of persistent PostgreSQL connections kept in the application pool.
OPENOCTOPUS_DATABASE_POOL_SIZE=5
# Additional PostgreSQL connections allowed when the persistent pool is full.
OPENOCTOPUS_DATABASE_MAX_OVERFLOW=10
# Seconds to wait for a PostgreSQL connection before failing the request.
OPENOCTOPUS_DATABASE_POOL_TIMEOUT=30
# Check that pooled PostgreSQL connections are alive before reusing them.
OPENOCTOPUS_DATABASE_POOL_PRE_PING=true
# Network interface or IP address on which the HTTP Server listens.
OPENOCTOPUS_HOST=127.0.0.1
# TCP port on which the HTTP Server listens.
OPENOCTOPUS_PORT=8080
# Secret used to sign authentication JWTs; replace it with a long random value.
OPENOCTOPUS_JWT_SECRET=change-me-in-production-use-a-long-random-secret
# Add the Secure attribute to authentication cookies; enable this when using HTTPS.
OPENOCTOPUS_COOKIE_SECURE=false
# Sensitive token a registering user can supply to create an administrator account.
OPENOCTOPUS_ADMIN_TOKEN=dev-admin-token
# HTTP(S) origin of the RustFS S3-compatible API, without a path or credentials.
OPENOCTOPUS_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Pre-created RustFS bucket that stores all server workspace objects.
OPENOCTOPUS_OBJECT_STORAGE_BUCKET=openoctopus
# S3 region used when signing RustFS requests.
OPENOCTOPUS_OBJECT_STORAGE_REGION=us-east-1
# Access key used to authenticate RustFS requests; treat it as sensitive.
OPENOCTOPUS_OBJECT_STORAGE_ACCESS_KEY=openoctopus
# Secret key used to authenticate RustFS requests; keep it confidential.
OPENOCTOPUS_OBJECT_STORAGE_SECRET_KEY=change-me-object-storage-secret
# Maximum concurrent workspace/internal object-storage operations.
# This must exceed the REST upload and download limits combined.
OPENOCTOPUS_OBJECT_STORAGE_MAX_CONNECTIONS=32
# Maximum number of concurrent REST workspace uploads across all users.
OPENOCTOPUS_REST_UPLOAD_MAX_CONCURRENCY=8
# Maximum number of concurrent REST workspace downloads across all users.
OPENOCTOPUS_REST_DOWNLOAD_MAX_CONCURRENCY=16
# Maximum number of concurrent REST workspace transfers owned by one user in either direction.
OPENOCTOPUS_REST_TRANSFER_MAX_CONCURRENCY_PER_USER=2
# Seconds a REST workspace transfer may wait for an admission slot.
OPENOCTOPUS_REST_TRANSFER_QUEUE_TIMEOUT_SECONDS=5
# Seconds a REST workspace transfer may make no progress before it is aborted.
OPENOCTOPUS_REST_TRANSFER_IDLE_TIMEOUT_SECONDS=30
# Memory limit in MiB for each isolated content-conversion process.
OPENOCTOPUS_CONTENT_CONVERSION_MEMORY_MB=1024
# Maximum runtime in seconds for one content-conversion process.
OPENOCTOPUS_CONTENT_CONVERSION_TIMEOUT_SECONDS=20
# Maximum number of content conversions running concurrently across all users.
OPENOCTOPUS_CONTENT_CONVERSION_MAX_CONCURRENCY=2
# Seconds a content conversion may wait for an admission slot.
OPENOCTOPUS_CONTENT_CONVERSION_QUEUE_TIMEOUT_SECONDS=5
# Maximum number of server-side web_fetch calls running concurrently across all users.
OPENOCTOPUS_WEB_FETCH_MAX_CONCURRENCY=16
# Maximum number of server-side web_fetch calls running concurrently for one user.
OPENOCTOPUS_WEB_FETCH_MAX_CONCURRENCY_PER_USER=2
# Seconds a server-side web_fetch call may wait for an admission slot.
OPENOCTOPUS_WEB_FETCH_QUEUE_TIMEOUT_SECONDS=5
# Maximum concurrent chat turns holding materialized Provider context across all users.
OPENOCTOPUS_CHAT_CONTEXT_MAX_CONCURRENCY=32
# Maximum concurrent chat turns holding materialized Provider context for one user.
OPENOCTOPUS_CHAT_CONTEXT_MAX_CONCURRENCY_PER_USER=2
# Seconds a chat turn may wait for a Provider-context admission slot.
OPENOCTOPUS_CHAT_CONTEXT_QUEUE_TIMEOUT_SECONDS=30
# Maximum number of pending Server-to-Client calls across all users.
OPENOCTOPUS_DEVICE_PENDING_CALLS_MAX=4096
# Maximum number of pending Server-to-Client calls for one user.
OPENOCTOPUS_DEVICE_PENDING_CALLS_MAX_PER_USER=64
# Maximum encoded call-frame and result-frame bytes reserved across all pending Client calls.
OPENOCTOPUS_DEVICE_PENDING_BYTES_MAX=268435456
# Maximum encoded call-frame and result-frame bytes reserved by one user's pending Client calls.
OPENOCTOPUS_DEVICE_PENDING_BYTES_MAX_PER_USER=33554432
# Maximum active device-transfer slots across all users.
OPENOCTOPUS_DEVICE_TRANSFER_MAX_CONCURRENCY=32
# Maximum active device-transfer slots owned by one user.
OPENOCTOPUS_DEVICE_TRANSFER_MAX_CONCURRENCY_PER_USER=2
# Seconds a device transfer may wait for an admission slot.
OPENOCTOPUS_DEVICE_TRANSFER_QUEUE_TIMEOUT_SECONDS=5
# Seconds a device transfer may make no progress before it is aborted.
OPENOCTOPUS_DEVICE_TRANSFER_IDLE_TIMEOUT_SECONDS=30
# Maximum runtime in seconds for one background RustFS workspace-purge attempt.
OPENOCTOPUS_WORKSPACE_DELETION_PURGE_TIMEOUT_SECONDS=300
# Seconds shutdown waits for the workspace-deletion worker before terminating its active child.
OPENOCTOPUS_WORKSPACE_DELETION_SHUTDOWN_GRACE_SECONDS=5
