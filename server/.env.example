OPENOCTOPUS_OBJECT_STORAGE_MAX_CONNECTIONS=32
OPENOCTOPUS_REST_UPLOAD_MAX_CONCURRENCY=8
OPENOCTOPUS_REST_DOWNLOAD_MAX_CONCURRENCY=16
