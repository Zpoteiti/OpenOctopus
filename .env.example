# Server image used by Docker Compose. Source checkouts can build this tag locally.
OPENOCTOPUS_IMAGE=ghcr.io/zpoteiti/openoctopus:v0.0.1
# Path to the complete Server settings file. Copy server/.env.example to customize limits.
OPENOCTOPUS_SERVER_ENV_FILE=server/.env.example
# Host address exposed by Docker Compose. Keep loopback when using a local reverse proxy.
OPENOCTOPUS_BIND_ADDRESS=127.0.0.1
# Host port exposed by Docker Compose.
OPENOCTOPUS_PUBLIC_PORT=8080
# URL-safe PostgreSQL password shared by PostgreSQL and the Server database URL.
OPENOCTOPUS_POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-secret
# RustFS access key shared by RustFS, the bucket initializer, and the Server.
OPENOCTOPUS_STORAGE_ACCESS_KEY=openoctopus
# RustFS secret key shared by RustFS, the bucket initializer, and the Server.
OPENOCTOPUS_STORAGE_SECRET_KEY=replace-with-a-long-random-storage-secret
# Object-storage bucket created by the one-time initializer and used by the Server.
OPENOCTOPUS_OBJECT_STORAGE_BUCKET=openoctopus
# Secret used to sign login tokens. Replace it before starting the stack.
OPENOCTOPUS_JWT_SECRET=replace-with-a-long-random-jwt-secret
# Token supplied once when registering an administrator account.
OPENOCTOPUS_ADMIN_TOKEN=replace-with-a-private-admin-registration-token
